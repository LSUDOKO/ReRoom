<?xml version="1.0"?>
<robot name="robot">
  <link name="basket_body">
    <visual>
      <geometry>
        <mesh filename="meshes/basket_body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="basket_lid">
    <visual>
      <geometry>
        <mesh filename="meshes/basket_lid.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="basket_lid_joint" type="revolute">
    <parent link="basket_body" />
