    <origin rpy="0 0 0" xyz="-0.14774700 0.19265851 -0.14738300" />
    <axis xyz="-0.99994500 -0.01051200 -0.00017700" />
    <limit lower="0.000000" upper="2.094000" effort="10" velocity="1" />
