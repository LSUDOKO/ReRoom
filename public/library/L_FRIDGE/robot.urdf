<?xml version="1.0"?>
<robot name="robot">
  <link name="body">
    <visual>
      <geometry>
        <mesh filename="meshes/body.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="door_main">
    <visual>
      <geometry>
        <mesh filename="meshes/door_main.glb" />
      </geometry>
    </visual>
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="door_main_joint" type="revolute">
    <parent link="body" />
    <child link="door_main" />
    <origin rpy="0 0 0" xyz="-0.30070300 0.72964202 0.21673700" />
    <axis xyz="-0.00040800 1.00000000 -0.00002900" />
    <limit lower="-1.570000" upper="0.000000" effort="10" velocity="1" />
  </joint>
</robot>